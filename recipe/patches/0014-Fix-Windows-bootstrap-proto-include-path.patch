Subject: [PATCH] Use the source proto root for Windows bootstrap generation

The feedstock builds the pinned Protobuf source as the main workspace.
Both descriptor.proto and compiler/plugin.proto are under src/, and the
bootstrap genrules already declare these files as inputs. Use that root
directly instead of deriving it through dirname in the Windows shell.

--- a/upb_generator/bootstrap_compiler.bzl
+++ b/upb_generator/bootstrap_compiler.bzl
@@ -18,7 +18,9 @@
 _stages = ["_stage0", "_stage1", ""]
 _protoc = "//src/google/protobuf/compiler/release:protoc_minimal"
 
-_extra_proto_path = "-I$$(dirname $(location //:descriptor_proto_srcs))/../.. "
+# This feedstock builds Protobuf as the main workspace, with protos in src/.
+# Avoid deriving the path through a host dirname executable on Windows.
+_extra_proto_path = "-Isrc "
 
 # This visibility is used automatically for anything used by the bootstrapping process.
 _bootstrap_visibility = [
