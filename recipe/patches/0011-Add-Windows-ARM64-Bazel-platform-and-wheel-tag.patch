From 77fcf37f17df1a0cc7ec48c483b044ed44f2568a Mon Sep 17 00:00:00 2001
From: Clay Warren <claywarren@users.noreply.github.com>
Date: Sun, 30 Aug 2026 03:04:00 -0500
Subject: [PATCH] Add Windows ARM64 Bazel platform and wheel tag

---
 build_defs/BUILD.bazel  | 9 +++++++++
 python/dist/BUILD.bazel | 9 +++++++++
 2 files changed, 18 insertions(+)

diff --git a/build_defs/BUILD.bazel b/build_defs/BUILD.bazel
index 381ffea..9c8df55 100644
--- a/build_defs/BUILD.bazel
+++ b/build_defs/BUILD.bazel
@@ -36,6 +36,15 @@ platform(
     ],
 )
 
+platform(
+    name = "arm64_windows-clang-cl",
+    constraint_values = [
+        "@platforms//cpu:arm64",
+        "@platforms//os:windows",
+        "@rules_cc//cc/private/toolchain:clang-cl",
+    ],
+)
+
 platform(
     name = "x64_windows-msvc-cl",
     constraint_values = PLATFORMS["win64"] + [
diff --git a/python/dist/BUILD.bazel b/python/dist/BUILD.bazel
index ee67220..b91ed4b 100644
--- a/python/dist/BUILD.bazel
+++ b/python/dist/BUILD.bazel
@@ -258,6 +258,14 @@ selects.config_setting_group(
     ],
 )
 
+config_setting(
+    name = "windows_aarch64",
+    constraint_values = [
+        "@platforms//cpu:arm64",
+        "@platforms//os:windows",
+    ],
+)
+
 pkg_files(
     name = "generated_wkt",
     srcs = [
@@ -415,6 +423,7 @@ py_wheel(
         ":osx_aarch64": "macosx_11_0_arm64",
         ":windows_x86_32": "win32",
         ":windows_x86_64": "win_amd64",
+        ":windows_aarch64": "win_arm64",
         "//conditions:default": "any",
     }),
     python_requires = ">=3.10",
-- 
